# Live credentials for the connector smoke tests and the first connector instances.
# Copy to .env (git-ignored) and fill in; never commit real values.
# Each plugin reads only its own keys. Tests that use them run only with
# TENKO_LIVE_PROXMOX=1, TENKO_LIVE_HASS=1 or TENKO_LIVE_UNIFI=1.
PROXMOX_URL=https://pve.example.test:8006
PROXMOX_TOKEN_ID=tenko@pve!inventory
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
HASS_URL=http://hass.example.test:8123
HASS_TOKEN=replace-with-a-long-lived-access-token
UNIFI_URL=https://unifi.example.test:8443
UNIFI_USER=tenko
UNIFI_PASSWORD=replace-with-the-local-account-password
UNIFI_LOCAL_API_KEY=replace-with-a-local-integration-api-key
