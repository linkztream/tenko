# Normalise line endings: LF in the repository and in the working tree.
* text=auto eol=lf

# Windows batch files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.pcap binary
*.pcapng binary

# SVG is XML text and stays diffable.
*.svg text

# Lockfiles (Cargo.lock, ui/package-lock.json) are intentionally kept diffable:
# do not mark them -diff or linguist-generated.
