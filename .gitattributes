# Normalise line endings: LF in the repository and in the working tree.
* text=auto eol=lf

# TypeScript sources are always text with LF, also where an editor on Windows writes CRLF
# into the working tree (the index already holds LF).
*.ts text eol=lf
*.tsx text eol=lf

# Windows batch files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.pcap binary
*.pcapng binary

# SVG is XML text and stays diffable.
*.svg text

# Lockfiles (Cargo.lock, ui/package-lock.json) are intentionally kept diffable:
# do not mark them -diff or linguist-generated.

# HIBP range fixtures reproduce the API response byte for byte, including CRLF line ends.
crates/tenko-auth/tests/fixtures/hibp/*.txt -text
crates/tenko-ipam/tests/fixtures/** -text

# Data-directory compatibility fixtures: redb files and the format marker, byte for byte.
*.redb binary
crates/tenko/tests/fixtures/datadir/** -text

# Fuzz seeds are inputs byte for byte (a byte-order mark, CRLF line ends).
fuzz/seeds/** -text
