00 00 00 00
# giaddr 0.0.0.0
00 00 00 00
# chaddr
00 00 5e 00 53 02 00 00 00 00 00 00 00 00 00 00
# sname: empty
00*64
# file: empty
00*128
# magic cookie
63 82 53 63
# option 53: DHCPDISCOVER
35 01 01
# option 61: client identifier, type 255, IAID, DUID-EN
3d 13 ff 8a 2b 5c 01 00 02 00 00 ab 11 1e 4d 8b
02 6a 77 31 c0
# option 57: maximum message size 1472
39 02 05 c0
