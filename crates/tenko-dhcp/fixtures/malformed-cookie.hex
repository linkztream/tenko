# A DHCPDISCOVER whose magic cookie is the BOOTP vendor area's zero octets (RFC 951).
#
# op 1, htype 1, hlen 6, hops 0
01 01 06 00
# xid
de ad be ef
# secs, flags
00 00 00 00
# ciaddr 0.0.0.0
00 00 00 00
# yiaddr 0.0.0.0
00 00 00 00
# siaddr 0.0.0.0
00 00 00 00
# giaddr 0.0.0.0
00 00 00 00
# chaddr
00 00 5e 00 53 01 00 00 00 00 00 00 00 00 00 00
# sname: empty
00*64
# file: empty
00*128
# no magic cookie: four zero octets
00 00 00 00
# option 53: DHCPDISCOVER
35 01 01
# end
ff
