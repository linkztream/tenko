# A DHCPOFFER whose option 52 has the value 4: the walk ends at option 52, the options
# before it stay readable, file and sname have no meaning.
#
# op 2, htype 1, hlen 6, hops 0
02 01 06 00
# xid
de ad be ef
# secs, flags
00 00 00 00
# ciaddr 0.0.0.0
00 00 00 00
# yiaddr 0.0.0.0
00 00 00 00
# siaddr 0.0.0.0
00 00 00 00
# giaddr 0.0.0.0
00 00 00 00
# chaddr
00 00 5e 00 53 01 00 00 00 00 00 00 00 00 00 00
# sname: empty
00*64
# file: empty
00*128
# magic cookie
63 82 53 63
# option 53: DHCPOFFER
35 01 02
# option 54: server identifier
36 04 c6 33 64 0a
# option 52: overload 4: no such value
34 01 04
# option 51: lease time
33 04 00 00 0e 10
# end
ff
