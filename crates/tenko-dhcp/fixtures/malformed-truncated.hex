# A DHCPDISCOVER whose fourth option (55) claims 40 octets where 6 remain: the options
# before it stay readable.
#
# op 1, htype 1, hlen 6, hops 0
01 01 06 00
# xid
de ad be ef
# secs, flags
00 00 00 00
# ciaddr 0.0.0.0
00 00 00 00
# yiaddr 0.0.0.0
00 00 00 00
# siaddr 0.0.0.0
00 00 00 00
# giaddr 0.0.0.0
00 00 00 00
# chaddr
00 00 5e 00 53 01 00 00 00 00 00 00 00 00 00 00
# sname: empty
00*64
# file: empty
00*128
# magic cookie
63 82 53 63
# option 53: DHCPDISCOVER
35 01 01
# option 61: client identifier
3d 07 01 00 00 5e 00 53 01
# option 12: host name "host-01"
0c 07 68 6f 73 74 2d 30 31
# option 55 with length 40 and six octets
37 28 01 03 06 0f 77 79
