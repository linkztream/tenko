# A DHCPDISCOVER heard directly on the server's link (no relay) without the broadcast
# flag; not padded. Modelled by hand on the option order and parameter request list this
# client sends; documentation addresses (RFC 5737) and MACs (RFC 7042).
#
# op 1, htype 1, hlen 6, hops 0
01 01 06 00
# xid
a1 01 24 16
# secs, flags
00 00 00 00
# ciaddr 0.0.0.0
00 00 00 00
# yiaddr 0.0.0.0
00 00 00 00
# siaddr 0.0.0.0
00 00 00 00
# giaddr 0.0.0.0
00 00 00 00
# chaddr
00 00 5e 00 53 24 00*10
# sname: empty
00*64
# file: empty
00*128
# magic cookie
63 82 53 63
# option 53: DHCPDISCOVER
35 01 01
# option 61: client identifier, type 1 and the MAC
3d 07 01 00 00 5e 00 53 24
# option 55: parameter request list
37 04 01 03 06 0f
# end
ff
