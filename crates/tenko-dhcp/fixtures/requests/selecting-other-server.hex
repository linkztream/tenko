# A relayed DHCPREQUEST in the SELECTING state that names another server, 198.51.100.99,
# as the chosen one; not padded. Modelled by hand on the option order and parameter
# request list this client sends; documentation addresses (RFC 5737) and MACs (RFC 7042).
#
# op 1, htype 1, hlen 6, hops 1
01 01 06 01
# xid
a1 01 21 0f
# secs, flags
00 00 00 00
# ciaddr 0.0.0.0
00 00 00 00
# yiaddr 0.0.0.0
00 00 00 00
# siaddr 0.0.0.0
00 00 00 00
# giaddr 192.0.2.1
c0 00 02 01
# chaddr
00 00 5e 00 53 21 00*10
# sname: empty
00*64
# file: empty
00*128
# magic cookie
63 82 53 63
# option 53: DHCPREQUEST
35 01 03
# option 61: client identifier, type 1 and the MAC
3d 07 01 00 00 5e 00 53 21
# option 50: requested address 192.0.2.170
32 04 c0 00 02 aa
# option 54: server identifier 198.51.100.99
36 04 c6 33 64 63
# option 55: parameter request list
37 03 01 03 06
# end
ff
