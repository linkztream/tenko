# A relayed DHCPDISCOVER whose parameter request list is split into two option 55
# instances that concatenate (RFC 3396); not padded. Modelled by hand on the option order
# and parameter request list this client sends; documentation addresses (RFC 5737) and
# MACs (RFC 7042).
#
# op 1, htype 1, hlen 6, hops 1
01 01 06 01
# xid
a1 01 26 18
# secs, flags
00 00 00 00
# ciaddr 0.0.0.0
00 00 00 00
# yiaddr 0.0.0.0
00 00 00 00
# siaddr 0.0.0.0
00 00 00 00
# giaddr 192.0.2.1
c0 00 02 01
# chaddr
00 00 5e 00 53 26 00*10
# sname: empty
00*64
# file: empty
00*128
# magic cookie
63 82 53 63
# option 53: DHCPDISCOVER
35 01 01
# option 57: maximum message size 1500
39 02 05 dc
# option 55: parameter request list, first instance
37 03 01 03 06
# option 55: parameter request list, second instance
37 03 0f 77 79
# end
ff
