00 00 00 00
# yiaddr 0.0.0.0
00 00 00 00
# siaddr 0.0.0.0
00 00 00 00
# giaddr 192.0.2.1
c0 00 02 01
# chaddr
00 00 5e 00 53 11 00*10
# sname: empty
00*64
# file: empty
00*128
# magic cookie
63 82 53 63
# option 53: DHCPREQUEST
35 01 03
# option 61: client identifier, type 1 and the MAC
3d 07 01 00 00 5e 00 53 11
# option 50: requested address 192.0.2.150
32 04 c0 00 02 96
# option 54: server identifier 198.51.100.10
36 04 c6 33 64 0a
# option 12: host name "WS-11"
0c 05 57 53 2d 31 31
# option 81: client FQDN: flags 0, RCODEs 0, name "WS-11"
51 08 00 00 00 57 53 2d 31 31
# option 60: vendor class identifier "MSFT 5.0"
3c 08 4d 53 46 54 20 35 2e 30
# option 55: parameter request list
37 0e 01 03 06 0f 1f 21 2b 2c 2e 2f 77 79 f9 fc
# end
