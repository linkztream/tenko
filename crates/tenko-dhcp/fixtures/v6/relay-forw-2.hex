fe 80 00 00 00 00 00 00 02 00 5e ff fe 00 53 01
# option 18, interface-id, 6 octets: "port-7"
00 12 00 06 70 6f 72 74 2d 37
# option 9, relay message, 74 octets: the SOLICIT of solicit-networkd.hex
00 09 00 4a
