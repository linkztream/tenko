; The AD domain zone corp.example.test as a zone transfer brings it: the controllers' records,
; the names Windows DHCP registered with their DHCID records, two of them stale.
$ORIGIN corp.example.test.
$TTL 3600
@ 3600 IN SOA dc1.corp.example.test. hostmaster.corp.example.test. 2026110105 900 600 86400 3600
@ 3600 IN NS dc1.corp.example.test.
@ 3600 IN NS dc2.corp.example.test.
@ 600 IN A 192.0.2.5
@ 600 IN A 192.0.2.6
dc1 3600 IN A 192.0.2.5
dc2 3600 IN A 192.0.2.6
domaindnszones 600 IN A 192.0.2.5
domaindnszones 600 IN A 192.0.2.6
forestdnszones 600 IN A 192.0.2.5
forestdnszones 600 IN A 192.0.2.6
_ldap._tcp 600 IN SRV 0 100 389 dc1.corp.example.test.
_ldap._tcp 600 IN SRV 0 100 389 dc2.corp.example.test.
_kerberos._tcp 600 IN SRV 0 100 88 dc1.corp.example.test.
_kerberos._tcp 600 IN SRV 0 100 88 dc2.corp.example.test.
_kpasswd._tcp 600 IN SRV 0 100 464 dc1.corp.example.test.
_kpasswd._tcp 600 IN SRV 0 100 464 dc2.corp.example.test.
_gc._tcp 600 IN SRV 0 100 3268 dc1.corp.example.test.
_gc._tcp 600 IN SRV 0 100 3268 dc2.corp.example.test.
_kerberos._udp 600 IN SRV 0 100 88 dc1.corp.example.test.
_kerberos._udp 600 IN SRV 0 100 88 dc2.corp.example.test.
_kpasswd._udp 600 IN SRV 0 100 464 dc1.corp.example.test.
_kpasswd._udp 600 IN SRV 0 100 464 dc2.corp.example.test.
_ldap._tcp.default-first-site-name._sites 600 IN SRV 0 100 389 dc1.corp.example.test.
_ldap._tcp.default-first-site-name._sites 600 IN SRV 0 100 389 dc2.corp.example.test.
_kerberos._tcp.default-first-site-name._sites 600 IN SRV 0 100 88 dc1.corp.example.test.
_kerberos._tcp.default-first-site-name._sites 600 IN SRV 0 100 88 dc2.corp.example.test.
_gc._tcp.default-first-site-name._sites 600 IN SRV 0 100 3268 dc1.corp.example.test.
_gc._tcp.default-first-site-name._sites 600 IN SRV 0 100 3268 dc2.corp.example.test.
_ldap._tcp.domaindnszones 600 IN SRV 0 100 389 dc1.corp.example.test.
_ldap._tcp.domaindnszones 600 IN SRV 0 100 389 dc2.corp.example.test.
_ldap._tcp.forestdnszones 600 IN SRV 0 100 389 dc1.corp.example.test.
_ldap._tcp.forestdnszones 600 IN SRV 0 100 389 dc2.corp.example.test.
tenko1 3600 IN A 192.0.2.53
