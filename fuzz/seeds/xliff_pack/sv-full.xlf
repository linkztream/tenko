<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="sv">
  <file id="ui">
    <mda:metadata>
      <mda:metaGroup category="language-pack">
        <mda:meta type="displayName">Svenska</mda:meta>
        <mda:meta type="author">Example translators</mda:meta>
        <mda:meta type="version">3.2</mda:meta>
        <mda:meta type="sourceLanguage">en</mda:meta>
      </mda:metaGroup>
    </mda:metadata>
    <group id="common">
      <unit id="common.cancel">
        <segment><source>Cancel</source><target>Avbryt</target></segment>
      </unit>
      <unit id="common.greeting">
        <segment><source>Signed in as {name}</source><target>Inloggad som {name}</target></segment>
      </unit>
      <unit id="common.count">
        <segment><source>{count, plural, one {# item} other {# items}}</source><target>{count, plural, one {# objekt} other {# objekt}}</target></segment>
      </unit>
      <unit id="common.kind">
        <segment><source>{kind, select, lease {DHCP lease} record {DNS record} other {Entry}}</source><target>{kind, select, lease {DHCP-lease} record {DNS-post} other {Post}}</target></segment>
      </unit>
      <unit id="common.apostrophe">
        <segment><source>Don''t save {name}''s '{'draft'}' twice</source><target>Spara inte '{'utkastet'}' för {name} två gånger</target></segment>
      </unit>
    </group>
    <group id="help">
      <unit id="help.text">
        <segment>
          <source>First line of the help.
Second line of the help.</source>
          <target>
            Första raden i hjälpen.
            Andra raden i hjälpen.
          </target>
        </segment>
      </unit>
    </group>
  </file>
</xliff>
