# shellcheck shell=bash
# Configuration of the gate (scripts/gate/README.md). Copy this file outside the repository,
# set your own values and load it in the shell that runs the gate:
#
#   . ~/tenko-gate.env && scripts/gate/gate.sh <name> <spec file>
#
# Paths are read by Windows programs (cargo, node), so write them with a drive letter and
# forward slashes (F:/...), without spaces. The values below are an example.

# A git worktree of this repository that only the gate uses (git worktree add F:/tenko-verify).
# Its first step resets it to a fresh merge-<name> branch: never point it at a checkout you
# work in.
export TENKO_GATE_WORKTREE=F:/tenko-verify

# Where the log and the outputs of each run go: gate-<name>.log, gate-<name>-nextest.txt,
# gate-<name>-junit.xml and others.
export TENKO_GATE_OUT_DIR=F:/gate-out

# Cargo target directories, kept between runs so that a run builds only what changed:
# the clippy and OpenAPI builds, the tests with the server binary the end-to-end tests drive,
# and the fuzz package.
export TENKO_GATE_TARGET_DIR=F:/cargo-target-verify
export TENKO_GATE_TESTS_TARGET_DIR=F:/cargo-target-verify-tests
export TENKO_GATE_FUZZ_TARGET_DIR=F:/cargo-target-fuzz

# The WSL distribution that runs the Linux clippy, and a clone of this repository inside it
# (with Rust installed there) on which the gate checks out the merge commit. Quote a path that
# starts with ~ so that it is read inside WSL, not here.
export TENKO_GATE_WSL_DISTRO=Ubuntu-24.04
# shellcheck disable=SC2088 # the tilde is meant for the shell inside WSL
export TENKO_GATE_WSL_CHECKOUT='~/tenko'

# Optional: test threads of the full nextest run and cargo build jobs (both 6 when unset).
# export TENKO_GATE_TEST_THREADS=6
# export TENKO_GATE_BUILD_JOBS=6

# watch-ci.sh: the GitHub repository whose workflow runs it waits for.
export TENKO_GATE_GITHUB_REPO=owner/tenko

# cargo, node, npm, git and wsl must be on PATH, for example:
# export PATH="/c/Users/<you>/.cargo/bin:$PATH"
