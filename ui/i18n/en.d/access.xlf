        <segment><source>Revoke {grant} of {holder}</source></segment>
      </unit>
      <unit id="access.grants.revoked">
        <segment><source>{count, plural, one {Grant of {holder} revoked} other {# grants revoked, starting with the one of {holder}}}</source></segment>
      </unit>
      <unit id="access.grant.text">
        <notes><note category="description">A grant in words. role is a role name, scope a scope in words, e.g. Operator over prefix 203.0.113.0/24 only.</note></notes>
        <segment><source>{role} over {scope}</source></segment>
      </unit>
      <unit id="access.scope.everything">
        <notes><note category="description">A token grant without a scope; follows "over" in access.grant.text.</note></notes>
        <segment><source>the whole installation</source></segment>
      </unit>
