      </unit>
      <unit id="access.grants.revoke_title">
        <segment><source>Revoke a grant of {holder}?</source></segment>
      </unit>
      <unit id="access.grants.revoke_body">
        <notes><note category="description">The argument grant is a grant in words, e.g. Operator over prefix 203.0.113.0/24 and everything inside it.</note></notes>
        <segment><source>{holder} loses: {grant}.</source></segment>
      </unit>
      <unit id="access.grants.revoke_cascade">
        <segment><source>{count, plural, =0 {No grant was issued under it so far.} one {The # grant issued under it goes too.} other {The # grants issued under it go too.}}</source></segment>
      </unit>
