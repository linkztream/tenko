<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en">
  <file id="tenko-ui">
    <group id="access">
      <unit id="access.title">
        <notes><note category="description">Title of the access page and its entry in the browser tab.</note></notes>
        <segment><source>Access</source></segment>
      </unit>
      <unit id="access.lede">
        <segment><source>Who may do what: the roles, the sign-in each role needs, scoped grants over VRFs, sites and prefixes, and the service accounts that automation uses. The server checks every request.</source></segment>
      </unit>
      <unit id="access.col.actions">
        <notes><note category="description">Hidden header of the column with the buttons of a row.</note></notes>
        <segment><source>Actions</source></segment>
      </unit>
      <unit id="access.role.admin">
        <segment><source>Administrator</source></segment>
      </unit>
      <unit id="access.role.operator">
        <segment><source>Operator</source></segment>
      </unit>
      <unit id="access.role.viewer">
        <segment><source>Viewer</source></segment>
      </unit>
      <unit id="access.role.auditor">
        <segment><source>Auditor</source></segment>
      </unit>
      <unit id="access.role.admin_description">
        <segment><source>Everything, including users, security settings, secrets and the system.</source></segment>
      </unit>
      <unit id="access.role.operator_description">
        <segment><source>Reads and changes the inventory, runs jobs and imports, approves proposals.</source></segment>
      </unit>
      <unit id="access.role.viewer_description">
        <segment><source>Reads the inventory, jobs and imports.</source></segment>
      </unit>
      <unit id="access.role.auditor_description">
        <segment><source>Reads the audit log, the audit export status and the system status, nothing else.</source></segment>
      </unit>
      <unit id="access.role.operator_grant">
        <notes><note category="description">Help under the role choice of a grant.</note></notes>
        <segment><source>Reads and changes what lies in the scope.</source></segment>
      </unit>
      <unit id="access.role.viewer_grant">
        <notes><note category="description">Help under the role choice of a grant.</note></notes>
        <segment><source>Reads what lies in the scope.</source></segment>
      </unit>
      <unit id="access.mfa.optional">
        <notes><note category="description">An MFA policy of a role: no second factor required.</note></notes>
        <segment><source>Any sign-in</source></segment>
      </unit>
      <unit id="access.mfa.totp_or_stronger">
        <segment><source>Authenticator code or passkey</source></segment>
      </unit>
      <unit id="access.mfa.passkey">
        <segment><source>Passkey or security key</source></segment>
      </unit>
      <unit id="access.mfa.profile_help">
        <segment><source>The role needs what the security profile asks.</source></segment>
      </unit>
      <unit id="access.mfa.optional_help">
        <segment><source>A password is enough, unless the profile asks for more.</source></segment>
      </unit>
      <unit id="access.mfa.totp_or_stronger_help">
        <segment><source>A password with an authenticator code or a recovery code, or a passkey.</source></segment>
      </unit>
      <unit id="access.mfa.passkey_help">
        <segment><source>A passkey or a hardware security key.</source></segment>
      </unit>
      <unit id="access.roles.heading">
        <segment><source>Roles and sign-in</source></segment>
      </unit>
      <unit id="access.roles.lede">
        <segment><source>A person needs the strictest sign-in of every role they hold, globally or through a grant. A requirement weaker than the profile has no effect beyond the profile.</source></segment>
      </unit>
      <unit id="access.roles.col.role">
        <segment><source>Role</source></segment>
      </unit>
      <unit id="access.roles.col.may">
        <segment><source>May</source></segment>
      </unit>
      <unit id="access.roles.col.held">
        <segment><source>Held</source></segment>
      </unit>
      <unit id="access.roles.col.mfa">
        <segment><source>Sign-in required</source></segment>
      </unit>
      <unit id="access.roles.global_only">
        <segment><source>Globally only</source></segment>
      </unit>
      <unit id="access.roles.global_or_grant">
        <segment><source>Globally or through a grant</source></segment>
      </unit>
      <unit id="access.roles.follows_profile">
        <segment><source>Follows the profile</source></segment>
      </unit>
      <unit id="access.roles.stored">
        <notes><note category="description">The argument profile is the requirement of the security profile, e.g. Any sign-in.</note></notes>
        <segment><source>Set for this role; the profile asks for: {profile}</source></segment>
      </unit>
      <unit id="access.roles.edit">
        <segment><source>Change</source></segment>
      </unit>
      <unit id="access.roles.edit_named">
        <segment><source>Change the sign-in of the role {role}</source></segment>
      </unit>
