        <segment><source>Follow the profile ({profile})</source></segment>
      </unit>
      <unit id="access.roles.weaker">
        <segment><source>This is weaker than the profile, which asks for {profile}; the profile wins.</source></segment>
      </unit>
      <unit id="access.roles.saved">
        <segment><source>Sign-in of the role {role} saved</source></segment>
      </unit>
      <unit id="access.grants.heading">
        <segment><source>Scoped grants</source></segment>
      </unit>
      <unit id="access.grants.lede">
        <segment><source>A grant gives a person or a service account the operator or viewer role over a VRF, a site or a prefix. Revoking a delegable grant also revokes the grants issued under it.</source></segment>
      </unit>
      <unit id="access.grants.lede_user">
        <segment><source>The roles this account holds over parts of the inventory, on top of its global roles.</source></segment>
      </unit>
      <unit id="access.grants.none">
        <segment><source>No scoped grants.</source></segment>
      </unit>
      <unit id="access.grants.add">
        <segment><source>Add grant</source></segment>
      </unit>
      <unit id="access.grants.add_title">
        <segment><source>Add a scoped grant</source></segment>
      </unit>
      <unit id="access.grants.add_confirm">
        <segment><source>Add grant</source></segment>
      </unit>
