<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en">
  <file id="tenko-ui">
    <group id="backup">
      <unit id="backup.title">
        <notes><note category="description">Title of the backup page and its entry in the browser tab.</note></notes>
        <segment><source>Backup</source></segment>
      </unit>
      <unit id="backup.lede">
        <segment><source>A backup is one encrypted file with the store, the keys of the vault and the TLS files, so the installation can be restored on a new host with that file and the key that opens it: a passphrase or the backup key file. Backups are always encrypted.</source></segment>
      </unit>
      <unit id="backup.now">
        <segment><source>Back up now</source></segment>
      </unit>
      <unit id="backup.running">
        <segment><source>Backup running…</source></segment>
      </unit>
      <unit id="backup.job_link">
        <segment><source>Follow the backup job</source></segment>
      </unit>
      <unit id="backup.warning.stale">
        <segment><source>No good backup for more than {days, number} days. Back up now, or switch the schedule on.</source></segment>
      </unit>
      <unit id="backup.warning.failed">
        <segment><source>The newest backup failed ({error}). See the list of backups below.</source></segment>
      </unit>
      <unit id="backup.warning.restored">
        <segment><source>This installation was started from a restore and no good backup has been made since. Take a backup now.</source></segment>
      </unit>
      <unit id="backup.restored.title">
        <segment><source>Restored from a backup</source></segment>
      </unit>
      <unit id="backup.restored.body">
        <segment><source>This installation was started from the backup {file}, made {created} and restored {at}.</source></segment>
      </unit>
      <unit id="backup.restored.nodes">
        <segment><source>Made on controller {source}, restored as controller {node}, at store revision {revision, number}.</source></segment>
      </unit>
      <unit id="backup.step_up.title">
        <segment><source>Sign in again to continue</source></segment>
      </unit>
      <unit id="backup.step_up.body">
        <segment><source>A backup copies every secret, and its settings decide where it goes, so both need a sign-in within the last five minutes. Sign in again, then come back to this page.</source></segment>
      </unit>
      <unit id="backup.step_up.sign_in">
        <segment><source>Sign in again</source></segment>
      </unit>
      <unit id="backup.state.heading">
        <segment><source>State</source></segment>
      </unit>
      <unit id="backup.state.target">
        <notes><note category="description">The directory the controller that answers writes to.</note></notes>
        <segment><source>Target directory</source></segment>
      </unit>
      <unit id="backup.state.last_good">
        <segment><source>Last good backup</source></segment>
      </unit>
      <unit id="backup.state.never">
        <segment><source>Never</source></segment>
      </unit>
      <unit id="backup.state.age_label">
        <segment><source>Age</source></segment>
      </unit>
      <unit id="backup.state.last_failed">
        <segment><source>Last failed backup</source></segment>
      </unit>
      <unit id="backup.state.next">
        <segment><source>Next scheduled backup</source></segment>
      </unit>
      <unit id="backup.state.not_scheduled">
        <segment><source>Not scheduled</source></segment>
      </unit>
      <unit id="backup.state.running">
        <segment><source>Running on this controller</source></segment>
      </unit>
      <unit id="backup.state.running_yes">
        <segment><source>Yes</source></segment>
      </unit>
      <unit id="backup.state.running_no">
        <segment><source>No</source></segment>
      </unit>
      <unit id="backup.state.recipient">
        <segment><source>Recipient key</source></segment>
      </unit>
      <unit id="backup.state.recipient_yes">
        <segment><source>Configured: every backup is encrypted to it</source></segment>
      </unit>
      <unit id="backup.state.recipient_no">
        <segment><source>Not configured: each backup needs a passphrase</source></segment>
      </unit>
      <unit id="backup.schedule.heading">
        <segment><source>Schedule</source></segment>
      </unit>
      <unit id="backup.schedule.enabled">
        <segment><source>Run scheduled backups</source></segment>
      </unit>
      <unit id="backup.schedule.enabled_help">
        <segment><source>Off until an administrator turns it on. Scheduled backups need a recipient key.</source></segment>
      </unit>
      <unit id="backup.schedule.off">
        <segment><source>Off</source></segment>
      </unit>
      <unit id="backup.schedule.every">
        <segment><source>Every {interval}</source></segment>
      </unit>
      <unit id="backup.schedule.interval">
        <segment><source>Hours between backups</source></segment>
      </unit>
      <unit id="backup.schedule.interval_help">
        <segment><source>1 to 168 hours. Now: every {every}.</source></segment>
      </unit>
      <unit id="backup.schedule.keep">
        <segment><source>Backups to keep</source></segment>
      </unit>
      <unit id="backup.schedule.keep_help">
        <segment><source>Older backups in the target directory are removed after a scheduled backup is written.</source></segment>
      </unit>
      <unit id="backup.schedule.recipient">
        <segment><source>Recipient key</source></segment>
      </unit>
      <unit id="backup.schedule.recipient_help">
        <segment><source>The public key that every backup is encrypted to. Create the key file with tenko backup keygen and paste the recipient it prints.</source></segment>
      </unit>
      <unit id="backup.schedule.target_dir">
        <segment><source>Target directory</source></segment>
      </unit>
      <unit id="backup.schedule.target_dir_help">
        <segment><source>An absolute directory on every controller. Empty: the default of each controller, here {dir}.</source></segment>
      </unit>
      <unit id="backup.schedule.include_config">
        <segment><source>Include the configuration file of the controller</source></segment>
      </unit>
      <unit id="backup.schedule.needs_recipient">
        <segment><source>Scheduled backups need a recipient key. Enter one below or switch the schedule off.</source></segment>
      </unit>
      <unit id="backup.schedule.error.interval">
        <segment><source>Enter a whole number from {min, number} to {max, number}.</source></segment>
      </unit>
      <unit id="backup.schedule.error.keep">
        <segment><source>Enter a whole number from {min, number} to {max, number}.</source></segment>
      </unit>
      <unit id="backup.schedule.error.recipient">
        <segment><source>A recipient is tkbr1: followed by 43 characters.</source></segment>
      </unit>
      <unit id="backup.schedule.error.target_dir">
        <segment><source>Enter an absolute directory, such as /var/backups/tenko.</source></segment>
      </unit>
      <unit id="backup.schedule.saved">
        <segment><source>Backup schedule saved: {schedule}</source></segment>
      </unit>
      <unit id="backup.runs.heading">
        <segment><source>Recent backups</source></segment>
      </unit>
      <unit id="backup.runs.none">
        <segment><source>No backups yet.</source></segment>
      </unit>
      <unit id="backup.runs.col.finished">
        <segment><source>Finished</source></segment>
      </unit>
      <unit id="backup.runs.col.outcome">
        <segment><source>Outcome</source></segment>
      </unit>
      <unit id="backup.runs.col.reason">
        <segment><source>Made</source></segment>
      </unit>
      <unit id="backup.runs.col.file">
        <segment><source>File</source></segment>
      </unit>
      <unit id="backup.runs.col.size">
        <segment><source>Size</source></segment>
      </unit>
      <unit id="backup.runs.col.node">
        <segment><source>Controller</source></segment>
      </unit>
      <unit id="backup.runs.col.actions">
        <segment><source>Actions</source></segment>
      </unit>
      <unit id="backup.run.succeeded">
        <segment><source>Succeeded</source></segment>
      </unit>
      <unit id="backup.run.failed">
        <segment><source>Failed</source></segment>
      </unit>
      <unit id="backup.run.scheduled">
        <segment><source>By the schedule</source></segment>
      </unit>
      <unit id="backup.run.manual">
        <segment><source>By hand</source></segment>
      </unit>
      <unit id="backup.slot.passphrase">
        <segment><source>a passphrase</source></segment>
      </unit>
      <unit id="backup.slot.recipient">
        <segment><source>the backup key file</source></segment>
      </unit>
      <unit id="backup.create.title">
        <segment><source>Back up now</source></segment>
      </unit>
      <unit id="backup.create.body">
        <segment><source>The backup is written to the target directory of the controller you are connected to, and audited.</source></segment>
      </unit>
      <unit id="backup.create.with_recipient">
        <segment><source>It is encrypted to the recipient key of the settings. You may add a passphrase that opens it as well.</source></segment>
      </unit>
      <unit id="backup.create.passphrase_only">
        <segment><source>No recipient key is set, so the backup needs a passphrase.</source></segment>
      </unit>
      <unit id="backup.create.passphrase">
        <segment><source>Passphrase</source></segment>
      </unit>
      <unit id="backup.create.passphrase_optional">
        <segment><source>Passphrase (optional)</source></segment>
      </unit>
      <unit id="backup.create.passphrase_help">
        <segment><source>At least {min, number} characters. It is used once and never stored: keep it apart from the backup, without it the backup may not open.</source></segment>
      </unit>
      <unit id="backup.create.again">
        <segment><source>Passphrase again</source></segment>
      </unit>
      <unit id="backup.create.error.short">
        <segment><source>Use at least {min, number} characters.</source></segment>
      </unit>
      <unit id="backup.create.error.mismatch">
        <segment><source>The two passphrases differ.</source></segment>
      </unit>
      <unit id="backup.create.done">
        <segment><source>Backup written: {file}</source></segment>
      </unit>
      <unit id="backup.restore.open">
        <segment><source>Restore command</source></segment>
      </unit>
      <unit id="backup.restore.open_named">
        <segment><source>Restore command for {file}</source></segment>
      </unit>
      <unit id="backup.restore.title">
        <segment><source>Restore {file}</source></segment>
      </unit>
      <unit id="backup.restore.body">
        <segment><source>Restore it on a new host with this command, then start Tenko there. Copy the file from the controller that wrote it first; the page cannot download it.</source></segment>
      </unit>
      <unit id="backup.restore.slots">
        <segment><source>The backup opens with: {slots}. Check it first with tenko backup verify.</source></segment>
      </unit>
      <unit id="backup.restore.note">
        <segment><source>A restore creates a single controller with the same sign-ins and certificate authority, so enrolled nodes keep trusting it; further controllers join it afterwards.</source></segment>
      </unit>
    </group>
  </file>
</xliff>
