        <segment><source>No recent backup</source></segment>
      </unit>
      <unit id="backup.stale.body">
        <segment><source>The last good backup is older than 7 days. Back up now, or switch the schedule on.</source></segment>
      </unit>
      <unit id="backup.step_up.title">
        <segment><source>Sign in again to back up</source></segment>
      </unit>
      <unit id="backup.step_up.body">
        <segment><source>A backup copies every secret, so it needs a sign-in within the last five minutes. Sign in again, then come back to this page.</source></segment>
      </unit>
