<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="sv">
  <file id="tenko-ui">
    <group id="dns-recursion">
      <unit id="dns.recursion.title">
        <notes><note category="description">Title of the page of the recursive resolver and its entry in the browser tab.</note></notes>
        <segment><source>Recursion</source><target>Rekursion</target></segment>
      </unit>
      <unit id="dns.nav.recursion">
        <notes><note category="description">Entry of the DNS sub-navigation that leads to the recursive resolver.</note></notes>
        <segment><source>Recursion</source><target>Rekursion</target></segment>
      </unit>
      <unit id="dns.recursion.trust_anchors.title">
        <notes><note category="description">Heading of the trust anchors, the keys that DNSSEC validation starts from.</note></notes>
        <segment><source>Trust anchors</source><target>Förtroendeankare</target></segment>
      </unit>
      <unit id="dns.recursion.trust_anchors.none">
        <notes><note category="description">Empty state of the trust anchors when the server lists none.</note></notes>
        <segment><source>There are no trust anchors.</source><target>Det finns inga förtroendeankare.</target></segment>
      </unit>
      <unit id="dns.recursion.ntas.title">
        <notes><note category="description">Heading of the negative trust anchors, names under which DNSSEC validation is switched off for a while.</note></notes>
        <segment><source>Negative trust anchors</source><target>Negativa förtroendeankare</target></segment>
      </unit>
      <unit id="dns.recursion.root_hints">
        <notes><note category="description">Label of the root hints, the addresses of the root servers that the resolver starts from.</note></notes>
        <segment><source>Root hints</source><target>Rotledtrådar</target></segment>
      </unit>
      <unit id="dns.recursion.priming.last">
        <notes><note category="description">Label of the time the resolver last asked the root servers for the list of root servers.</note></notes>
        <segment><source>Last priming</source><target>Senaste priming</target></segment>
      </unit>
      <unit id="dns.recursion.infra.title">
        <notes><note category="description">Heading of the infrastructure cache, what the resolver remembers about name servers.</note></notes>
        <segment><source>Infrastructure cache</source><target>Infrastrukturcache</target></segment>
      </unit>
      <unit id="dns.sec.secure">
        <notes><note category="description">DNSSEC validation state: the answer is proven genuine.</note></notes>
        <segment><source>Secure</source><target>Säker</target></segment>
      </unit>
      <unit id="dns.sec.insecure">
        <notes><note category="description">DNSSEC validation state: the zone is provably not signed.</note></notes>
        <segment><source>Insecure</source><target>Osäker</target></segment>
      </unit>
      <unit id="dns.sec.bogus">
        <notes><note category="description">DNSSEC validation state: the signatures are wrong or missing, so the answer is refused.</note></notes>
        <segment><source>Bogus</source><target>Ogiltig</target></segment>
      </unit>
      <unit id="dns.sec.indeterminate">
        <notes><note category="description">DNSSEC validation state: validation could not reach a result.</note></notes>
        <segment><source>Indeterminate</source><target>Obestämd</target></segment>
      </unit>
      <unit id="dns.sec.unvalidated">
        <notes><note category="description">DNSSEC validation state: nothing validated the answer.</note></notes>
        <segment><source>Unvalidated</source><target>Ej validerad</target></segment>
      </unit>
      <unit id="dns.resolution.recurse">
        <notes><note category="description">How a view resolves names it does not serve: the resolver iterates from the root.</note></notes>
        <segment><source>Recurse</source><target>Rekursera</target></segment>
      </unit>
      <unit id="dns.resolution.forward">
        <notes><note category="description">How a view resolves names it does not serve: through the default forwarder.</note></notes>
        <segment><source>Forward to the default forwarder</source><target>Vidarebefordra till standardvidarebefordraren</target></segment>
      </unit>
      <unit id="dns.resolution.refuse">
        <notes><note category="description">How a view resolves names it does not serve: it refuses them.</note></notes>
        <segment><source>Refuse</source><target>Neka</target></segment>
      </unit>
      <unit id="dns.resolution.default">
        <notes><note category="description">How a view resolves names it does not serve: as the profile says.</note></notes>
        <segment><source>Profile default</source><target>Profilens standard</target></segment>
      </unit>
      <unit id="dns.fwd.mode.recurse">
        <notes><note category="description">Mode of a forwarding rule that resolves the names under its suffix iteratively instead of forwarding them.</note></notes>
        <segment><source>Recurse</source><target>Rekursera</target></segment>
      </unit>
      <unit id="dns.fwd.preset.dot">
        <notes><note category="description">Preset in the forwarding rule dialog: one rule for all names to a resolver that is reached over DNS over TLS.</note></notes>
        <segment><source>Forward everything to a DoT resolver</source><target>Vidarebefordra allt till en DoT-resolver</target></segment>
      </unit>
      <unit id="dns.cache.col.state">
        <notes><note category="description">Column of the cache table: the DNSSEC validation state of the entry.</note></notes>
        <segment><source>State</source><target>Tillstånd</target></segment>
      </unit>
      <unit id="dns.cache.ede">
        <notes><note category="description">Extended DNS error (RFC 8914) of a bogus entry; {code} is the info code number.</note></notes>
        <segment><source>EDE {code}</source><target>EDE {code}</target></segment>
      </unit>
      <unit id="dns.cache.ede_hint">
        <notes><note category="description">Explains the extended DNS error code shown next to the state of an entry; {code} is the info code number.</note></notes>
        <segment><source>Extended DNS error {code} (RFC 8914), sent with the failure answer</source><target>Utökat DNS-fel {code} (RFC 8914), skickas med felsvaret</target></segment>
      </unit>
      <unit id="dns.cache.signature_expiry">
        <notes><note category="description">Explains when the signatures of a validated entry expire; {time} is a date and time.</note></notes>
        <segment><source>Signatures valid until {time}</source><target>Signaturerna gäller till {time}</target></segment>
      </unit>
      <unit id="dns.recursion.status.title">
        <notes><note category="description">Heading of the block that shows the recursive resolver of this server's DNS node.</note></notes>
        <segment><source>Resolver on this node</source><target>Resolver på den här noden</target></segment>
      </unit>
      <unit id="dns.recursion.status.running">
        <notes><note category="description">Tag that says the recursive resolver of the node is running.</note></notes>
        <segment><source>Running</source><target>Körs</target></segment>
      </unit>
      <unit id="dns.recursion.status.loading">
        <notes><note category="description">Shown while the state of the recursive resolver is being read.</note></notes>
        <segment><source>Reading the resolver…</source><target>Läser resolvern…</target></segment>
      </unit>
      <unit id="dns.recursion.status.no_node">
        <notes><note category="description">Shown on the recursion page when this server has no DNS node, so there is no resolver to show.</note></notes>
        <segment><source>This server has no DNS node, so there is no resolver to show.</source><target>Den här servern har ingen DNS-nod, så det finns ingen resolver att visa.</target></segment>
      </unit>
      <unit id="dns.recursion.status.off.title">
        <notes><note category="description">Heading of the note that says the node's recursive resolver is switched off.</note></notes>
        <segment><source>Recursion is off</source><target>Rekursionen är avstängd</target></segment>
      </unit>
      <unit id="dns.recursion.status.off.body">
        <notes><note category="description">Explains that the resolver is off and where it is switched on; enabled and [dns.recursion] are names in the configuration file and stay as they are.</note></notes>
        <segment><source>The node answers from its own zones and its forwarders only. Set enabled in the [dns.recursion] section of tenko.toml to resolve names from the root.</source><target>Noden svarar bara från sina egna zoner och vidarebefordrare. Sätt enabled i avsnittet [dns.recursion] i tenko.toml för att slå upp namn från roten.</target></segment>
      </unit>
      <unit id="dns.recursion.facts.title">
        <notes><note category="description">Heading of the card with the hints and the last priming of the recursive resolver.</note></notes>
        <segment><source>Root hints and priming</source><target>Rotledtrådar och priming</target></segment>
      </unit>
      <unit id="dns.recursion.hints.shipped">
        <notes><note category="description">Source of the root hints: the list that ships with the product.</note></notes>
        <segment><source>Shipped with Tenko</source><target>Medföljer Tenko</target></segment>
      </unit>
      <unit id="dns.recursion.hints.date">
        <notes><note category="description">Label of the date of the root hints.</note></notes>
        <segment><source>Hints dated</source><target>Rotledtrådarnas datum</target></segment>
      </unit>
      <unit id="dns.recursion.priming.never">
        <notes><note category="description">Shown when the resolver has not primed itself yet.</note></notes>
        <segment><source>No priming yet</source><target>Ingen priming än</target></segment>
      </unit>
      <unit id="dns.recursion.priming.ok">
        <notes><note category="description">Tag: the last priming succeeded, a root server answered.</note></notes>
        <segment><source>Succeeded</source><target>Lyckades</target></segment>
      </unit>
      <unit id="dns.recursion.priming.failed">
        <notes><note category="description">Tag: the last priming failed, no root server answered.</note></notes>
        <segment><source>Failed</source><target>Misslyckades</target></segment>
      </unit>
      <unit id="dns.recursion.priming.duration">
        <notes><note category="description">How long the last priming took; {ms} is a number of milliseconds.</note></notes>
        <segment><source>took {ms} ms</source><target>tog {ms} ms</target></segment>
      </unit>
      <unit id="dns.recursion.priming.expires">
        <notes><note category="description">Label of the time the resolver's list of root servers expires and the next priming is due.</note></notes>
        <segment><source>Root servers expire</source><target>Rotservrarna går ut</target></segment>
      </unit>
      <unit id="dns.recursion.prime.button">
        <notes><note category="description">Button that asks the node to prime its resolver now.</note></notes>
        <segment><source>Prime now</source><target>Prima nu</target></segment>
      </unit>
      <unit id="dns.recursion.prime.sent">
        <notes><note category="description">Confirms that the node was asked to prime its resolver.</note></notes>
        <segment><source>Priming requested</source><target>Priming begärd</target></segment>
      </unit>
      <unit id="dns.recursion.prime.failed">
        <notes><note category="description">Title of the error when the node could not be asked to prime its resolver.</note></notes>
        <segment><source>The priming could not be requested</source><target>Primingen kunde inte begäras</target></segment>
      </unit>
      <unit id="dns.recursion.problems.title">
        <notes><note category="description">Heading of the warning that lists what the recursive resolver reports as wrong.</note></notes>
        <segment><source>The resolver reports a problem</source><target>Resolvern rapporterar ett problem</target></segment>
      </unit>
      <unit id="dns.recursion.problem.priming_failed">
        <notes><note category="description">Problem of the resolver: no root server answered the priming query.</note></notes>
        <segment><source>No root server answered the priming query, so recursed names are answered SERVFAIL until a priming succeeds.</source><target>Ingen rotserver svarade på priming-frågan, så rekursiva namn besvaras med SERVFAIL tills en priming lyckas.</target></segment>
      </unit>
      <unit id="dns.recursion.roots.title">
        <notes><note category="description">Heading of the table of root servers the resolver uses.</note></notes>
        <segment><source>Root servers</source><target>Rotservrar</target></segment>
      </unit>
      <unit id="dns.recursion.roots.col.name">
        <notes><note category="description">Column of the root servers table: the name of the server.</note></notes>
        <segment><source>Server</source><target>Server</target></segment>
      </unit>
      <unit id="dns.recursion.roots.col.address">
        <notes><note category="description">Column of the root servers table: the address in use.</note></notes>
        <segment><source>Address</source><target>Adress</target></segment>
      </unit>
      <unit id="dns.recursion.roots.col.srtt">
        <notes><note category="description">Column of the root servers table: the smoothed round-trip time to the server.</note></notes>
        <segment><source>Round-trip time</source><target>Svarstid</target></segment>
      </unit>
      <unit id="dns.recursion.roots.srtt_none">
        <notes><note category="description">Shown for a root server that has not answered yet, so its round-trip time is unknown.</note></notes>
        <segment><source>not measured yet</source><target>inte mätt än</target></segment>
      </unit>
      <unit id="dns.recursion.ms">
        <notes><note category="description">A time in milliseconds; {ms} is formatted already.</note></notes>
        <segment><source>{ms} ms</source><target>{ms} ms</target></segment>
      </unit>
      <unit id="dns.recursion.infra.zones">
        <notes><note category="description">Label of the number of zone cuts the infrastructure cache holds.</note></notes>
        <segment><source>Zone cuts</source><target>Zonavgränsningar</target></segment>
      </unit>
      <unit id="dns.recursion.infra.servers">
        <notes><note category="description">Label of the number of name server addresses the infrastructure cache holds.</note></notes>
        <segment><source>Server addresses</source><target>Serveradresser</target></segment>
      </unit>
      <unit id="dns.recursion.infra.names">
        <notes><note category="description">Label of the number of name server names the infrastructure cache holds.</note></notes>
        <segment><source>Server names</source><target>Servernamn</target></segment>
      </unit>
      <unit id="dns.recursion.infra.of">
        <notes><note category="description">How full a cache is; {count} is what it holds and {max} its bound, both formatted already.</note></notes>
        <segment><source>{count} of {max}</source><target>{count} av {max}</target></segment>
      </unit>
      <unit id="dns.recursion.counters.title">
        <notes><note category="description">Heading of the counters of the resolver since the role started.</note></notes>
        <segment><source>Since the role started</source><target>Sedan rollen startade</target></segment>
      </unit>
      <unit id="dns.recursion.counter.answered">
        <notes><note category="description">Counter: client queries the resolver answered with an answer or NXDOMAIN.</note></notes>
        <segment><source>Answered</source><target>Besvarade</target></segment>
      </unit>
      <unit id="dns.recursion.counter.servfail">
        <notes><note category="description">Counter: client queries the resolver answered with SERVFAIL.</note></notes>
        <segment><source>Answered SERVFAIL</source><target>Besvarade med SERVFAIL</target></segment>
      </unit>
      <unit id="dns.recursion.counter.budget">
        <notes><note category="description">Counter: client queries stopped because they used up their budget of queries, restarts or depth.</note></notes>
        <segment><source>Stopped by the work budget</source><target>Stoppade av arbetsbudgeten</target></segment>
      </unit>
      <unit id="dns.recursion.counter.timeout">
        <notes><note category="description">Counter: client queries that ran out of time.</note></notes>
        <segment><source>Timed out</source><target>Tidsgränsen överskreds</target></segment>
      </unit>
      <unit id="dns.recursion.counter.local">
        <notes><note category="description">Counter: client queries answered from locally served zones.</note></notes>
        <segment><source>Answered from local zones</source><target>Besvarade från lokala zoner</target></segment>
      </unit>
      <unit id="dns.recursion.counter.failure_cache_hits">
        <notes><note category="description">Counter: client queries answered SERVFAIL from the failure cache without asking an authority server.</note></notes>
        <segment><source>Answered from the failure cache</source><target>Besvarade från felcachen</target></segment>
      </unit>
      <unit id="dns.recursion.counter.subqueries">
        <notes><note category="description">Counter: queries the resolver sent to authority servers.</note></notes>
        <segment><source>Queries sent to authorities</source><target>Frågor skickade till auktoritativa servrar</target></segment>
      </unit>
      <unit id="dns.recursion.counter.unwanted">
        <notes><note category="description">Counter: answers from authority servers that were dropped as unwanted.</note></notes>
        <segment><source>Unwanted answers dropped</source><target>Oönskade svar som kastats</target></segment>
      </unit>
      <unit id="dns.log.col.resolution">
        <notes><note category="description">Column of the query log: how the answer was found.</note></notes>
        <segment><source>Resolution</source><target>Uppslagning</target></segment>
      </unit>
      <unit id="dns.log.col.subqueries">
        <notes><note category="description">Column of the query log: the queries the resolver sent to authority servers for this query.</note></notes>
        <segment><source>Sub-queries</source><target>Delfrågor</target></segment>
      </unit>
      <unit id="dns.log.resolution.zone">
        <notes><note category="description">How a query was answered: from a zone the node serves.</note></notes>
        <segment><source>Zone</source><target>Zon</target></segment>
      </unit>
      <unit id="dns.log.resolution.cache">
        <notes><note category="description">How a query was answered: from the cache.</note></notes>
        <segment><source>Cache</source><target>Cache</target></segment>
      </unit>
      <unit id="dns.log.resolution.denial">
        <notes><note category="description">How a query was answered: from the cache of proven non-existence.</note></notes>
        <segment><source>Denial cache</source><target>Nekandecache</target></segment>
      </unit>
      <unit id="dns.log.resolution.stale">
        <notes><note category="description">How a query was answered: from an expired cache entry because the upstreams failed.</note></notes>
        <segment><source>Stale cache</source><target>Utgången cache</target></segment>
      </unit>
      <unit id="dns.log.resolution.forward">
        <notes><note category="description">How a query was answered: by a forwarder.</note></notes>
        <segment><source>Forwarded</source><target>Vidarebefordrad</target></segment>
      </unit>
      <unit id="dns.log.resolution.recurse">
        <notes><note category="description">How a query was answered: by the recursive resolver.</note></notes>
        <segment><source>Recursed</source><target>Rekurserad</target></segment>
      </unit>
      <unit id="dns.log.resolution.local">
        <notes><note category="description">How a query was answered: from local data of the resolver.</note></notes>
        <segment><source>Local data</source><target>Lokala data</target></segment>
      </unit>
      <unit id="dns.log.resolution.policy">
        <notes><note category="description">How a query was answered: by a policy such as a block list.</note></notes>
        <segment><source>Policy</source><target>Policy</target></segment>
      </unit>
      <unit id="dns.log.resolution.refused">
        <notes><note category="description">How a query was answered: refused.</note></notes>
        <segment><source>Refused</source><target>Nekad</target></segment>
      </unit>
    </group>
  </file>
</xliff>
