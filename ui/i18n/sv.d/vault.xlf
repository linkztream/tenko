  <file id="tenko-ui">
    <group id="vault">
      <unit id="vault.title">
        <notes><note category="description">Title of the vault page and its entry in the browser tab.</note></notes>
        <segment><source>Vault</source><target>Valv</target></segment>
      </unit>
      <unit id="vault.lede">
        <segment><source>The key-encryption key protects every secret in the store. Each controller keeps it sealed by the operating system; a rotation creates a new key on every controller and re-encrypts the data keys under it.</source><target>Nyckelkrypteringsnyckeln skyddar alla hemligheter i lagret. Varje controller håller den förseglad av operativsystemet. En rotation skapar en ny nyckel på varje controller och krypterar om datanycklarna med den.</target></segment>
      </unit>
      <unit id="vault.weak">
        <notes><note category="description">Tag on a key protection that has no protection by the operating system.</note></notes>
        <segment><source>Weak</source><target>Svag</target></segment>
      </unit>
      <unit id="vault.downgrade">
        <notes><note category="description">Tag on a controller whose key is protected less well than it was.</note></notes>
        <segment><source>Weaker than before</source><target>Svagare än tidigare</target></segment>
      </unit>
      <unit id="vault.key.heading">
        <notes><note category="description">The argument node is the number of the controller that answers.</note></notes>
        <segment><source>Key of controller {node}</source><target>Nyckel för controller {node}</target></segment>
      </unit>
