{
  "name": "tenko-ui",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "description": "Web UI for Tenko DDI, built into ui/dist and embedded in the server binary",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "node --import ./scripts/ts6.mjs ./node_modules/eslint/bin/eslint.js --max-warnings=0 . && node scripts/i18n.mjs --check && node scripts/api-types.mjs --check && node scripts/css-logical.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e/.artifacts/report",
    "i18n": "node scripts/i18n.mjs",
    "api:types": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "size": "node scripts/size.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "intl-messageformat": "^12.1.3",
    "solid-js": "^1.9.17",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@mswjs/interceptors": "^0.45.7",
    "@playwright/test": "^1.64.0",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^22.20.5",
    "@typescript/typescript6": "^6.0.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "typescript": "^7.0.2"
  }
}
